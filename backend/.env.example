# Sao chép thành backend/.env rồi điền giá trị thật. KHÔNG commit file .env.
# Lấy ở Supabase Dashboard > Project Settings > API (Data API / API Keys).
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Khóa bí mật phía máy chủ (secret key "sb_secret_..." hoặc service_role cũ).
# Chỉ dùng trên máy chạy worker, tuyệt đối không đưa vào frontend/.
SUPABASE_SECRET_KEY=
