# Sao chép thành web/.env.local rồi điền giá trị thật. KHÔNG commit file .env*.
# Trên Vercel: nhập 2 biến này ở Project Settings > Environment Variables.
# Lấy ở Supabase Dashboard > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Khóa công khai (publishable "sb_publishable_..." hoặc anon cũ). KHÔNG dùng khóa bí mật ở đây.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Khóa bí mật, CHỈ dùng phía máy chủ (không có NEXT_PUBLIC_). Cần cho trang quản trị đặt lại mật khẩu.
# Trên Vercel: thêm vào Environment Variables, không tick "Expose" ra trình duyệt.
SUPABASE_SECRET_KEY=

# Tùy chọn: để web gọi GitHub Actions chạy worker ngay khi có bài mới (không đặt thì worker chỉ chạy theo lịch mỗi giờ).
# Token: GitHub > Settings > Developer settings > Fine-grained tokens, chỉ chọn repo này, quyền "Actions: Read and write".
GITHUB_DISPATCH_TOKEN=
# Repo chứa workflow, dạng chủ-sở-hữu/tên-repo.
GITHUB_REPOSITORY=
